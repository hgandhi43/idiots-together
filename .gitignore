# Unreal Engine 5 standard ignore patterns

# Visual Studio / IDE temporary files & builds
.vs/
.idea/
.vscode/
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates

# Compiled binaries and intermediate build output
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
.ue/

# Package & Engine outputs
*.apk
*.mfi
*.target
*.app
*.ipa

# Autogenerated C++ files
Source/*/.gen.cpp

# Windows / OS junk
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp

# Mac OS junk
.DS_Store
.AppleDouble
.LSOverride

# Local Antigravity / Agent scratch directories
scratch/
